# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Все ключи создаются на аккаунтах ЗАКАЗЧИКА (см. docs/06-plan-handover.md).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID старших оценщиков через запятую: только они утверждают итоговую цену
SENIOR_APPRAISER_IDS=

# --- Claude API ---
ANTHROPIC_API_KEY=
# Основная модель: поиск дефектов и ревью
CARVAL_MODEL_MAIN=claude-opus-5-5
# Дешёвая модель: первая проверка качества фото
CARVAL_MODEL_FAST=claude-haiku-5-5

# --- Хранилище ---
# local  — всё в папке data/local (для разработки, без Supabase)
# supabase — рабочий режим
CARVAL_STORAGE=local
SUPABASE_URL=
# service_role ключ: только на сервере, никогда в клиенте или в git
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=car-photos

# --- Расчёт ---
CARVAL_CURRENCY=KZT

# --- Запчасти ---
# Искать цены в интернете, если в базе поставщиков (config/suppliers.csv) пусто
CARVAL_PARTS_WEB_SEARCH=true
CARVAL_CITY=Алматы

# --- Голос (Yandex SpeechKit) ---
# Мастер говорит голосом, бот распознаёт и отвечает голосом. Пусто — только текст.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
CARVAL_VOICE_LANG=ru-RU
CARVAL_VOICE_NAME=alena
CARVAL_VOICE_REPLIES=true
